generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String    @db.Text
  phone               String?
  image               String    @default("")
  status              String    @default("active")
  role                String    @default("owner")
  provider            String    @default("credentials")
  isVerified          Boolean   @default(false)
  bio                 String?   @db.Text
  businessName        String?
  contactNumber       String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String?
  facebook            String?
  instagram           String?
  twitter             String?
  linkedin            String?
  refreshToken        String?   @db.Text
  emailVerifyToken    String?
  emailVerifyExpire   DateTime?
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shops               Shop[]
  shopMembers         ShopMember[]
  subscriptions       UserSubscription[]

  @@map("users")
}

model Shop {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  slug          String   @unique
  logo          String   @default("")
  contactNumber String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  facebook      String?
  instagram     String?
  headerText    String?
  footerText    String   @default("Thank you for your purchase!")
  showLogo      Boolean  @default(true)
  accentColor   String   @default("#005C72")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User       @relation(fields: [ownerId], references: [id])
  members       ShopMember[]
  products      Product[]
  customers     Customer[]
  invoices      Invoice[]

  @@map("shops")
}

model ShopMember {
  id               String   @id @default(cuid())
  shopId           String
  userId           String
  role             String   @default("moderator")
  canCreateProduct Boolean  @default(true)
  canCreateInvoice Boolean  @default(true)
  canViewReports   Boolean  @default(false)
  canManageOrders  Boolean  @default(true)
  invitedBy        String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop             Shop     @relation(fields: [shopId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([shopId, userId])
  @@map("shop_members")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String
  parentId  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  image     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@map("brands")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  shopId        String?
  slug          String
  varientId     String?
  brandId       String?
  description   String   @db.Text
  price         Float
  previousPrice Float?
  extraPrice    Float?
  buyingPrice   Float?
  stock         Int      @default(0)
  sold          Int      @default(0)
  rating        Float    @default(0)
  location      String   @default("Dhaka")
  featured      Boolean  @default(false)
  freeDelivery  Boolean  @default(false)
  isDemo        Boolean  @default(false)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop?    @relation(fields: [shopId], references: [id])
  brand         Brand?   @relation(fields: [brandId], references: [id])

  @@unique([shopId, slug])
  @@map("products")
}

model Varient {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique
  price     Float
  stock     Int      @default(0)
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("varients")
}

model VarientAttribute {
  id        String   @id @default(cuid())
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("varient_attributes")
}

model Customer {
  id            String   @id @default(cuid())
  shopId        String
  ownerId       String
  createdBy     String
  name          String   @default("")
  phone         String   @default("")
  email         String   @default("")
  address       String   @default("")
  totalInvoices Int      @default(0)
  totalSpent    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])
  invoices      Invoice[]

  @@map("customers")
}

model Invoice {
  id              String        @id @default(cuid())
  shopId          String
  ownerId         String
  orderId         String?
  createdBy       String
  invoiceNumber   String        @unique
  invoiceDate     DateTime      @default(now())
  customerId      String?
  customerName    String        @default("")
  customerPhone   String        @default("")
  customerEmail   String        @default("")
  customerAddress String        @default("")
  subtotal        Float         @default(0)
  tax             Float         @default(0)
  discountType    String        @default("flat")
  discount        Float         @default(0)
  discountAmount  Float         @default(0)
  advanceAmount   Float         @default(0)
  deliveryCharge  Float         @default(0)
  isDeliveryPaid  Boolean       @default(false)
  grandTotal      Float         @default(0)
  notes           String?       @db.Text
  status          String        @default("draft")
  is_deleted      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  shop            Shop          @relation(fields: [shopId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  name      String
  quantity  Int
  unitPrice Float
  total     Float

  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model BillingCycle {
  id               String    @id @default(cuid())
  name             String
  durationInMonths Int
  discountAmount   Float     @default(0)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  deactivatedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions    UserSubscription[]

  @@map("billing_cycles")
}

model SubscriptionPlan {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  description          String    @default("") @db.Text
  price                Float     @default(0)
  maxShops             Int       @default(1)
  maxModeratorsPerShop Int       @default(0)
  maxProductsPerShop   Int       @default(10)
  maxInvoicesPerMonth  Int       @default(20)
  featReceiptCustom    Boolean   @default(false)
  featExportPdf        Boolean   @default(false)
  featAnalytics        Boolean   @default(false)
  isActive             Boolean   @default(true)
  sortOrder            Int       @default(0)
  deactivatedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  subscriptions        UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String
  billingCycleId   String
  status           String    @default("pending")
  paymentMethod    String    @default("free")
  paymentReference String    @default("")
  paymentAmount    Float     @default(0)
  startDate        DateTime?
  endDate          DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
  billingCycle     BillingCycle     @relation(fields: [billingCycleId], references: [id])

  @@map("user_subscriptions")
}
